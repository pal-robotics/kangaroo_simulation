	<joint name="arm_cover_left_fixed_joint" type="fixed">
		<origin rpy="1.3963 0 0" xyz="0 0.105954 0.384396"/>
		<parent link="torso_link"/>
		<child link="arm_cover_left_cover_link"/>
	</joint>
	<link name="arm_cover_right_cover_link">
		<inertial>
			<origin rpy="0 0 0" xyz="-2E-05 -0.00021 -0.04402"/>
			<mass value="0.14355"/>
			<inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00021" iyz="-1E-05" izz="0.0003"/>
