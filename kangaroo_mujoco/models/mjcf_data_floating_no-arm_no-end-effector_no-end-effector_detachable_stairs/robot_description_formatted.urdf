			<origin rpy="0 0 0" xyz="-0.000443003666554599 0.000522074497974099 -0.0153068327087122"/>
			<mass value="0.00199617753343338"/>
			<inertia ixx="5.9973064680877E-07" ixy="2.01121334144999E-08" ixz="-8.68902393943816E-09" iyy="5.90181580371415E-07" iyz="1.10619053149078E-08" izz="8.97962347086075E-07"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="full/foot-ft.obj"/>
			</geometry>
