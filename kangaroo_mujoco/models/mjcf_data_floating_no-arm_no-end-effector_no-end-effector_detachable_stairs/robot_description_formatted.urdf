	</link>
	<joint name="right_foot_ft" type="fixed">
		<origin rpy="0 3.1416 0" xyz="0 0 0.014"/>
		<parent link="right_foot"/>
		<child link="right_foot_ft"/>
		<axis xyz="0 0 0"/>
	</joint>
	<link name="right_sole_link">
		<inertial>
			<origin rpy="0 0 0" xyz="0.000379366462454072 5.80159494661185E-05 -0.00336003668438848"/>
			<mass value="0.34359589794105"/>
			<inertia ixx="0.000243921537522367" ixy="-3.79473815942421E-07" ixz="1.12448005808514E-07" iyy="0.0015816516325665" iyz="5.17989402289206E-08" izz="0.00182204612839865"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="full/foot-sole.obj"/>
