<?xml version="1.0" ?>
<mujoco model="scene">
    <include file="mujoco_description_formatted.xml"/>
    <compiler angle="radian" balanceinertia="true" discardvisual="false" strippath="false"/>
    <option integrator="implicitfast"/>
    <statistic center="0 0 1" extent="1.8" meansize="0.04"/>
    <visual>
        <headlight ambient=".4 .4 .4" diffuse=".8 .8 .8" specular="1 1 1"/>
        <rgba force="1 0 0 1"/>
        <global azimuth="160" elevation="-20"/>
        <map force="0.01"/>
        <scale contactheight="0.2" contactwidth="0.5" forcewidth="0.3"/>
        <quality shadowsize="8192"/>
    </visual>
    <asset>
        <texture builtin="gradient" height="800" rgb1="1 1 1" rgb2="1 1 1" type="skybox" width="800"/>
        <texture builtin="checker" height="300" mark="edge" markrgb="0 0 0" name="groundplane" rgb1="1 1 1" rgb2="1 1 1" type="2d" width="300"/>
        <material name="groundplane" reflectance="0" texrepeat="5 5" texture="groundplane" texuniform="true"/>
    </asset>
    <worldbody>
        <geom conaffinity="0" contype="1" material="groundplane" name="floor" size="0 0 0.01" type="plane"/>
    </worldbody>
</mujoco>
